# Copy this file to .env and replace each placeholder with a random value.
# Set one AI provider key on the server to enable open-ended AI chat.
# OpenRouter is preferred and stays on the server; model names can be changed without rebuilding the app.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1
# OPENROUTER_SITE_URL=
# Optional OpenAI-compatible fallback:
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VIDMAHI_ACCESS_TOKEN=replace-with-a-unique-random-token
VIDMAHI_AGENT_TOKEN=replace-with-a-different-random-token
FLASK_SECRET_KEY=replace-with-a-unique-random-secret
VIDMAHI_SERVER_URL=http://127.0.0.1:5000
# Optional. Render configures a persistent database path.
# DATABASE_PATH=instance/vidmahi.sqlite3
